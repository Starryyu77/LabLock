#!/usr/bin/env bash
set -euo pipefail

HOST="both"
TEAM=false
NO_PROMPTS=false

for arg in "$@"; do
  case "$arg" in
    --host=*) HOST="${arg#*=}" ;;
    --team) TEAM=true ;;
    --no-prompts) NO_PROMPTS=true ;;
    *) echo "Unknown option: $arg" >&2; exit 2 ;;
  esac
done

LABLOCK_HOME="$(cd "$(dirname "$0")" && pwd)"
CANONICAL_SOURCE="$HOME/.lablock/source"

echo "LabLock setup"
echo "  Source: $LABLOCK_HOME"
echo "  Canonical: $CANONICAL_SOURCE"
echo "  Host:   $HOST"
echo "  Team:   $TEAM"
echo

command -v bun >/dev/null 2>&1 || {
  echo "Bun is not installed." >&2
  if [ "$NO_PROMPTS" = false ]; then
    read -r -p "Install Bun now? (y/N) " yn
    if [ "$yn" = "y" ]; then
      curl -fsSL https://bun.sh/install | bash
      export PATH="$HOME/.bun/bin:$PATH"
    else
      exit 1
    fi
  else
    exit 1
  fi
}

BUN_VERSION=$(bun --version)
BUN_MAJOR=${BUN_VERSION%%.*}
if [ "$BUN_MAJOR" -lt 1 ]; then
  echo "Bun >= 1.0 is required; found $BUN_VERSION" >&2
  exit 1
fi
echo "Bun $BUN_VERSION"

command -v git >/dev/null 2>&1 || { echo "git not found" >&2; exit 1; }
echo "git $(git --version | awk '{print $3}')"

if ! command -v gh >/dev/null 2>&1; then
  echo "Warning: gh CLI not found. GitHub features will be unavailable." >&2
fi

cd "$LABLOCK_HOME"
bun install

mkdir -p "$HOME/.lablock"
if [ "$LABLOCK_HOME" != "$CANONICAL_SOURCE" ]; then
  rm -rf "$CANONICAL_SOURCE"
  ln -s "$LABLOCK_HOME" "$CANONICAL_SOURCE"
  echo "Canonical source: ~/.lablock/source -> $LABLOCK_HOME"
fi

BIN_DIR="${LABLOCK_BIN_DIR:-$HOME/.local/bin}"
mkdir -p "$BIN_DIR"
if [ -d "$BIN_DIR/lablock" ] && [ ! -L "$BIN_DIR/lablock" ]; then
  echo "Cannot install CLI: $BIN_DIR/lablock is a directory" >&2
  exit 1
fi
rm -f "$BIN_DIR/lablock"
ln -s "$LABLOCK_HOME/bin/lablock.ts" "$BIN_DIR/lablock"
echo "CLI: $BIN_DIR/lablock -> $LABLOCK_HOME/bin/lablock.ts"
case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *) echo "Warning: $BIN_DIR is not in PATH; add it to run 'lablock' directly." >&2 ;;
esac

install_skill_links() {
  local target_root="$1"
  local label="$2"
  mkdir -p "$target_root"
  for skill_dir in "$LABLOCK_HOME"/lab-*; do
    [ -f "$skill_dir/SKILL.md" ] || continue
    local name
    name="$(basename "$skill_dir")"
    rm -rf "$target_root/$name"
    ln -s "$skill_dir" "$target_root/$name"
    echo "$label skill: $target_root/$name -> $skill_dir"
  done
}

case "$HOST" in
  claude|both)
    install_skill_links "$HOME/.claude/skills" "Claude Code"
    ;;
esac

case "$HOST" in
  codex|both)
    install_skill_links "$HOME/.agents/skills" "Codex"
    ;;
esac

chmod +x "$LABLOCK_HOME/hooks/"*.sh
chmod +x "$LABLOCK_HOME/hooks/"*.ts
chmod +x "$LABLOCK_HOME/bin"/lablock*.ts

if [ ! -f "$HOME/.lablock/config.yaml" ]; then
  cat > "$HOME/.lablock/config.yaml" <<EOF
version: 1
default_host: $HOST
auto_upgrade: false
analytics: off
editor: ${EDITOR:-vim}
gh_cli: auto
EOF
  echo "Created ~/.lablock/config.yaml"
fi

if [ "$TEAM" = true ]; then
  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "--team requires being inside a git repository" >&2
    exit 1
  }
  case "$HOST" in
    claude|both)
      mkdir -p .claude/skills
      for skill_dir in "$LABLOCK_HOME"/lab-*; do
        [ -f "$skill_dir/SKILL.md" ] || continue
        rm -rf ".claude/skills/$(basename "$skill_dir")"
        cp -R "$skill_dir" ".claude/skills/$(basename "$skill_dir")"
      done
      ;;
  esac
  case "$HOST" in
    codex|both)
      mkdir -p .agents/skills
      for skill_dir in "$LABLOCK_HOME"/lab-*; do
        [ -f "$skill_dir/SKILL.md" ] || continue
        rm -rf ".agents/skills/$(basename "$skill_dir")"
        cp -R "$skill_dir" ".agents/skills/$(basename "$skill_dir")"
      done
      ;;
  esac
fi

echo
echo "LabLock installed."
echo "Next: cd your-research-project && run /lab-init"
