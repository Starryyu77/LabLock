exp_id: {{exp_id}}
shortname: {{shortname}}
hypothesis: |
  {{hypothesis}}
parent: {{parent}}
created: {{date}}
status: active

locked_invariants:
  config:
{{#each config_invariants}}
    {{this.key}}: {{this.value}}
{{/each}}
  files:
{{#each file_invariants}}
    - path: {{this.path}}
      hash: {{this.hash}}
      reason: {{this.reason}}
{{/each}}
  probes:
{{#each probes}}
    - name: {{this.name}}
      command: {{this.command}}
      requires: [{{join this.requires ", "}}]
      timeout_sec: {{this.timeout_sec}}
      run_on: [{{join this.run_on ", "}}]
      reason: {{this.reason}}
{{/each}}

controlled_changes:
{{#if controlled_changes.added}}
  added:
{{#each controlled_changes.added}}
    - {{this}}
{{/each}}
{{/if}}
{{#if controlled_changes.removed}}
  removed:
{{#each controlled_changes.removed}}
    - {{this}}
{{/each}}
{{/if}}
{{#if controlled_changes.modified}}
  modified:
{{#each controlled_changes.modified}}
    - {{this}}
{{/each}}
{{/if}}

{{#if naming}}
naming:
{{#if naming.matrix_id}}
  matrix_id: {{naming.matrix_id}}
{{/if}}
{{#if naming.variable_id}}
  variable_id: {{naming.variable_id}}
{{/if}}
{{#if naming.canonical_variable}}
  canonical_variable: {{naming.canonical_variable}}
{{/if}}
{{#if naming.variant_value}}
  variant_value: {{naming.variant_value}}
{{/if}}
{{#if naming.paper_label}}
  paper_label: {{naming.paper_label}}
{{/if}}

{{/if}}
kill_criteria:
{{#each kill_criteria}}
  - {{this}}
{{/each}}

success_criteria:
{{#each success_criteria}}
  - {{this}}
{{/each}}
